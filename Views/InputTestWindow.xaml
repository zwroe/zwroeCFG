<Window x:Class="Rebind.Views.InputTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zwroeCFG Input Test" Width="650" Height="450" MinWidth="510" MinHeight="310"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#181818" Foreground="#F1F1F1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Input Test" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Capture mapped inputs and zwroeCFG output requests. Steam Input and Apex events are outside this trace."
                       TextWrapping="Wrap" Foreground="#C2C2C2" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="CaptureButton" Content="Start capture" Width="112" Height="28" Margin="0,0,12,0" Click="CaptureButton_Click"/>
            <TextBlock x:Name="CaptureStatus" Text="Capture stopped · Last 300 events kept in memory" VerticalAlignment="Center" Foreground="#C2C2C2"/>
        </DockPanel>
        <TextBox x:Name="TraceText" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 AutomationProperties.Name="Input test trace" Padding="10" Background="#111111" Foreground="#EEEEEE"
                 BorderBrush="#454545" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
