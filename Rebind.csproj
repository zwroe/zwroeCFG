<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
     <OutputType>WinExe</OutputType>
     <AssemblyName>zwroe</AssemblyName>
     <TargetFramework>net8.0-windows</TargetFramework>
     <Nullable>enable</Nullable>
     <ImplicitUsings>enable</ImplicitUsings>
     <UseWPF>true</UseWPF>
     <Platforms>AnyCPU;x64</Platforms>
     <ApplicationIcon>konata.ico</ApplicationIcon>
   </PropertyGroup>

   <ItemGroup>
     <PackageReference Include="Nefarius.ViGEm.Client" Version="1.16.150" />
   </ItemGroup>

   <ItemGroup>
     <None Update="mappingConfig.json">
       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
     </None>
     <Resource Include="konata.ico"/>
     <Resource Include="konata2.png"/>
   </ItemGroup>

 </Project>
